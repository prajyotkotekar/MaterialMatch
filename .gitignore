# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Secrets (never commit credentials)
.env
.env.*
kaggle.json
.streamlit/secrets.toml

# Local tooling and notes
.vscode/
.idea/
*.md
!README.md

# Data: only the small CSVs the app needs are tracked
data/Image/
data/external_validation/
data/feedback/
data/processed/*
!data/processed/class_mapping.csv

# Model weights: only the shipped model (best.*) is tracked
*.pt
!ml/classifier/weights/best.pt
ml/classifier/weights/*
!ml/classifier/weights/best.pt
!ml/classifier/weights/best.ood.npz
!ml/classifier/weights/best.hierarchy.json

# Training runs, Kaggle outputs, reports and logs (regenerated by the scripts)
ml/classifier/runs/
ml/classifier/kaggle_runs/
ml/classifier/reports/
*.log
ml/classifier/train_log*.txt
*.cache

# OS
.DS_Store
Thumbs.db
desktop.ini
